{
  "version": 4,
  "platform": "Facebook",
  "phase": "facebook_native_newsroom",
  "note": "Near-continuous Facebook newsroom policy: poll Telegram every 5 minutes, publish fresh news promptly, and drain bursts with a short 5-minute Facebook gap instead of flooding.",
  "language": {
    "primary": "ar",
    "style": "clear_modern_standard_arabic",
    "keep_technical_terms_in_english_when_clearer": true,
    "use_moroccan_darija": false,
    "literal_translation": false
  },
  "publishing_policy": {
    "publish_every_collected_item": true,
    "skip_items": false,
    "publish_as_soon_as_ready": true,
    "minimum_gap_minutes": 5,
    "max_posts_per_publisher_attempt": 1,
    "queue_mode": "priority_one_per_5_minute_slot",
    "aging_boost_after_hours": 6,
    "priority_order": [
      "breaking",
      "warning",
      "important",
      "security",
      "freshness"
    ],
    "never_delay_for_threads_peak_times": true,
    "continuous_poll_minutes": 5,
    "backlog_drain_gap_minutes": 5
  },
  "source_policy": {
    "remove_intcyberdigest_branding": true,
    "remove_intcyberdigest_site_links": true,
    "remove_intcyberdigest_social_links": true,
    "keep_external_original_sources": true,
    "facebook_first_comment_source_link": true
  },
  "learning_policy": {
    "status": "instrument_delivery_now_collect_meta_metrics_when_permissions_allow",
    "collect_post_level_metrics_when_available": true,
    "measure_after_hours": [
      2,
      24,
      72
    ],
    "recalculate_after_minimum_posts": 50,
    "metrics": [
      "reach",
      "views",
      "engagement",
      "reactions",
      "comments",
      "shares",
      "video_watch_time",
      "followers_gained",
      "qualified_views",
      "earnings_if_available"
    ],
    "dimensions": [
      "content_type",
      "attention_label",
      "media_mode",
      "caption_length",
      "paragraph_count",
      "emoji",
      "hashtags",
      "publish_hour",
      "source_age_minutes"
    ]
  },
  "caption_policy": {
    "brand_hashtag": "#CyberoPlus",
    "max_hashtags": 2,
    "add_topic_hashtag": true,
    "topic_hashtags": {
      "cybersecurity": "#الأمن_السيبراني",
      "artificial_intelligence": "#الذكاء_الاصطناعي",
      "privacy": "#الخصوصية",
      "technology": "#تقنية"
    },
    "emoji_policy": "deterministic_from_verified_attention_and_content_type",
    "source_link_location": "first_comment"
  }
}
